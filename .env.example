# Supabase project settings → API. Only the PUBLIC anon/publishable key belongs here.
# NEVER put the service-role / secret key in any VITE_* variable — it would ship to the browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Leave both empty to run in Local Mode (data stays in this browser's storage).
